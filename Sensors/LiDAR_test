// TF-Luna TX -> Arduino RX1, TF-Luna RX -> Arduino TX1

void setup() {
  Serial.begin(115200);   
  Serial1.begin(115200);  
}

void loop() {
  
  if (Serial1.available() >= 9) {
    uint8_t raw[9];
    Serial1.readBytes(raw, 9);

    // Validate frame header (must be 0x59, 0x59)
    if (raw[0] == 0x59 && raw[1] == 0x59) {
      int dist_cm = raw[2] + raw[3] * 256;
      int amp     = raw[4] + raw[5] * 256;
      float temp  = (raw[6] + raw[7] * 256) / 100.0;

      if (amp < 100) {
        Serial.println("Distance: UNRELIABLE (signal too weak)");
      } else {
        Serial.print("Distance: ");
        Serial.print(dist_cm);
        Serial.print(" cm | Amp: ");
        Serial.print(amp);
        Serial.print(" | Temp: ");
        Serial.print(temp);
        Serial.println(" C");
      }
    }
  }
}
