#include <Arduino.h>

#include "KillSwitch.h"
#include "KillSwitchConfig.h"
#include "LED.h"
#include "MiniMessengerHandler.h"
#include "MotorConfig.h"
#include "MotoronDrive.h"
#include "ReviveButton.h"
#include "RobotFSM.h"

MotoronDrive Robot(MOTORON_ADDR_FRONT, MOTORON_ADDR_REAR);
RobotFSM Fsm(Robot);
KillSwitch killSwitch(KILL_SWITCH_PIN);
LED statusLed;
ReviveButton reviveButton;
MiniMessengerHandler messenger;

void handleSerialEvent()
{
    if (!Serial.available())
    {
        return;
    }

    const char command = Serial.read();

    switch (command)
    {
        case 's':
            Fsm.startMission();
            break;
        case 'c':
            Fsm.exitClearanceReceived();
            break;
        case 'd':
            Fsm.exitDoorDetected();
            break;
        case 'o':
            Fsm.exitDoorOpened();
            Fsm.entryDoorOpened();
            break;
        case 'a':
            Fsm.mainArenaReached();
            break;
        case 'f':
            Fsm.rfidDetected("A1", true);
            break;
        case 'i':
            Fsm.rfidDetected("A1", false);
            break;
        case 'r':
            Fsm.emergencyWarningReceived();
            break;
        case 'e':
            Fsm.entryAirlockReached();
            break;
        case 'b':
            Fsm.baseReached();
            break;
        case 'x':
            Fsm.markStranded();
            break;
        case 'v':
            Fsm.reviveFromStranded();
            break;
        default:
            break;
    }
}

void setup()
{
    Serial.begin(115200);

    while (!Serial)
    {
        ;
    }

    Robot.begin();
    killSwitch.begin();
    statusLed.begin();
    reviveButton.begin();
    messenger.begin();

    Fsm.begin();

    Serial.println("TERM 3 CHALLENGE FSM READY");
    Serial.println("Serial test: s=start c=clearance d=door o=open a=arena f=fertile i=infertile r=return e=entry b=base x=stranded v=revive");
}

void loop()
{
    killSwitch.update();
    reviveButton.update();
    messenger.update();

    if (killSwitch.isTriggered())
    {
        Fsm.triggerEmergencyStop();
        statusLed.showEmergency();
        return;
    }

    Fsm.clearEmergencyStop();

    if (messenger.isStopTriggered())
    {
        messenger.clearStopTriggered();
        Fsm.emergencyWarningReceived();
    }

    if (reviveButton.isPressed())
    {
        Fsm.reviveFromStranded();
        statusLed.showButtonPressed();
    }
    else if (Fsm.isEmergencyReturn() || Fsm.isEmergencyStop())
    {
        statusLed.showEmergency();
    }
    else
    {
        statusLed.showNormal();
    }

    handleSerialEvent();
    Fsm.update();
}
