#include <Arduino.h>
#include "config.h"
#include "wifi_handler.h"
#include "IRSensor.h"
#include "LidarSensor.h"
#include "MotorControl.h"
#include "ServoControl.h"

// Global objects
IRSensor irSensor(PIN_IR_SENSOR);
LidarSensor lidarSensor;
MotorControl motors;
ServoControl headServo(PIN_SERVO);

void setup() {
  // Initialize serial communication
  Serial.begin(115200);
  while (!Serial) {
    ; // wait for serial port to connect. Needed for native USB port only
  }

  Serial.println("System Initializing...");

  // Initialize WiFi and UDP listener
  setupWiFi();

  // Initialize modules
  irSensor.begin();
  lidarSensor.begin();
  motors.begin();
  headServo.begin();
  
  headServo.setAngle(90);

  Serial.println("System Ready!");
}

void loop() {
  // Periodically check for UDP packets
  handleUDP();
  
  // Obstacle avoidance logic
  int irDist = irSensor.readDistance();
  int lidarDist = lidarSensor.getDistance();
  
  // Use thresholds from config.h
  if (irDist > OBSTACLE_THRESHOLD_IR || (lidarDist > 0 && lidarDist < OBSTACLE_THRESHOLD_LIDAR)) {
      motors.stop();
      Serial.println("Obstacle detected! Stopping.");
  } else {
      motors.setSpeed(MOTOR_SPEED_DEFAULT);
  }

  delay(20); 
}
